{
  "name": "slang-translator",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "serve": "node server/index.mjs",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "data:validate": "node scripts/data.mjs validate",
    "data:export": "node scripts/data.mjs export",
    "data:import": "node scripts/data.mjs import",
    "data:add": "node scripts/data.mjs add",
    "data:merge": "node scripts/data.mjs merge",
    "data:stats": "node scripts/data.mjs stats"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
